  <collaboration id="Id_b8e887cf-6bb3-4e2b-9ebd-4ea25415f478" name="P03. Technical Analysis">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Conducting technical analysis for approval of FNDE financial support requests.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_348fd00d-f3e5-4bd6-ba46-9bf98f70b78b" name="Processo principal" processRef="Id_4441d6c4-46e5-4a24-a8fe-e940edb686c5">
