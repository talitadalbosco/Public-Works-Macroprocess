  <collaboration id="Id_7dd12e45-73ca-4407-8408-7c97d6afe144" name="P06. Submission of Proposals">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Proposal submission process considering the synergy between the various activities of municipalities and Law No. 14,133/2021 - Law on Public Procurement and Administrative Contracts.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_984cb6ca-52cb-43da-b298-799f9de64c01" name="Processo principal" processRef="Id_dbd697f1-b423-4b87-9707-dac6be62d923">
