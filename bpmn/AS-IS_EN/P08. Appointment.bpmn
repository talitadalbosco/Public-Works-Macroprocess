      <outgoing>Id_248116c5-2dc4-4711-9966-c4fa7d461255</outgoing>
      <ioSpecification id="Id_fbe40fdb-f9a1-4a02-9f5b-5b8b527b750a">
        <dataOutput id="Id_776d6e37-b47f-4161-96a4-155c31b19a3e">
          <documentation />
