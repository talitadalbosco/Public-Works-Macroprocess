        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_0b26e77e-4325-4e88-8bc7-ffb33f57bafb</incoming>
      <outgoing>Id_248116c5-2dc4-4711-9966-c4fa7d461255</outgoing>
      <ioSpecification id="Id_2edc72ec-f2b7-4c5e-b9c5-dbd1c66a4905">
