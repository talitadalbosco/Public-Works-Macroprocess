  <collaboration id="Id_0d1cd59a-2232-42fa-8e6d-27afca649a59" name="P23. Close Construction Contract">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Process for analyzing the completion of the work, taking into account information on physical progress and considering the synergy between the various activities of the municipalities and Law No. 14,133/2021 - Law on Public Procurement and Administrative Contracts.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_a3dab8f7-f164-4597-b384-af1628e87b0c" name="Processo principal" processRef="Id_837a1a9c-93d8-4395-931e-ec62ff4b4ef7">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#000000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="isMainParticipant" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
    <participant id="Id_c6467aa9-25b2-4168-aa7a-571dbf80bd66" name="Public Works Process - FNDE/MEC and Municipalities - P23. Close Construction Contract" processRef="Id_82a7b649-d84a-434e-aeb4-9d82a4f6c14e">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Process for analyzing the completion of the work, taking into account information on physical progress and considering the synergy between the various activities of the municipalities and Law No. 14,133/2021 - Law on Public Procurement and Administrative Contracts.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
