            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Educação Infantil; Ensino Fundamental; Ensino Médio</text>
    </textAnnotation>
    <textAnnotation id="Id_69653e00-8bed-4d67-8ea1-32b7b6889e96">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Qual será o local de implantação do empreendimento que contém a demanda reprimida</text>
    </textAnnotation>
    <textAnnotation id="Id_5e0e7034-e878-4cc5-8d7b-65758870bab1">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Peças Técnicas: PDF ou DWG; Arquivos: PDF, Word, Excel; Imagens: JPEG, PNG</text>
    </textAnnotation>
    <textAnnotation id="Id_2fed5518-b9f0-4abe-88e7-de137d59eb8c">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Verificar se possui os critérios mínimos: dimensões, inclinação, entorno, etc</text>
    </textAnnotation>
    <textAnnotation id="Id_42a71d91-6a2f-4617-928c-b0ba17c857bc">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Escolher a tipologia que melhor atenda a demanda reprimida</text>
    </textAnnotation>
    <textAnnotation id="Id_5501f717-a2ed-4fd9-b3d9-4cf60cc5366a">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Os terrenos devem possuir documento de propriedade em nome do município</text>
    </textAnnotation>
    <textAnnotation id="Id_70d90851-6aa6-49d9-a688-92ae1d7c47a9">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
