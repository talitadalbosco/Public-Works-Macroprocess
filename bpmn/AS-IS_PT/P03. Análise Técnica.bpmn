            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Analisar o projeto dentro dos critérios de elegibilidade e priorização de atendimento</text>
    </textAnnotation>
    <textAnnotation id="Id_5d1dfb98-c490-45a8-8712-80a37d4194b9">
      <documentation />
