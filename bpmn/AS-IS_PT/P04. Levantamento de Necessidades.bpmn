            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Doc. contendo a justificativa, o serviço a ser contratado, previsão de datas e indicação de equipe</text>
    </textAnnotation>
