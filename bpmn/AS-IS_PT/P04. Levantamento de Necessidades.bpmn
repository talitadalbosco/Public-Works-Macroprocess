            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Esta saída inicia o processo P05. Planejamento da Contratação</text>
    </textAnnotation>
    <textAnnotation id="Id_8147a730-7e6e-4be3-a522-610bcf9c6caa">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
