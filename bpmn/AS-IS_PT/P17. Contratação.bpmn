    <task id="Id_667d48f7-8d94-499a-aaac-c9cfef6a89f6" name="7.4 Publicação do Contrato">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:10pt;font-weight:normal;font-style:normal;"&gt;Art. 94. A divulga&amp;ccedil;&amp;atilde;o no Portal Nacional de Contrata&amp;ccedil;&amp;otilde;es P&amp;uacute;blicas (PNCP) &amp;eacute; condi&amp;ccedil;&amp;atilde;o indispens&amp;aacute;vel para aefic&amp;aacute;cia do contrato e de seus aditamentos e dever&amp;aacute; ocorrer nos seguintes prazos, contados da data de sua assinatura:&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
