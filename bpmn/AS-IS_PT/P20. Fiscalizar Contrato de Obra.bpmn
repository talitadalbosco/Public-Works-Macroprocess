  <collaboration id="Id_e747f609-ce3d-4965-9415-410e1309aad2" name="P20. Fiscalizar Contrato de Obra">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da produ&amp;ccedil;&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contratos Administrativos.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_fcb2659f-6e88-4418-aa6a-0151a335101e" name="Processo principal" processRef="Id_36b69947-22ff-43de-bae6-917a45745738">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#000000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="isMainParticipant" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
    <participant id="Id_43a52c67-6ba8-42b4-bff2-0eff16340b99" name="Processo de Obras Públicas - FNDE/MEC e Municípios - P20. Fiscalizar Contrato de Obra" processRef="Id_d510139a-4169-4266-826f-1e18c803850e">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da produ&amp;ccedil;&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contratos Administrativos.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#F2F2F2" />
            <bizagi:BizagiProperty name="borderColor" value="#A2A2A2" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
  </collaboration>
