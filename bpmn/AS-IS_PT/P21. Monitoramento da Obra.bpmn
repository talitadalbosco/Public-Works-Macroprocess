  <collaboration id="Id_060ae591-1ad3-45df-a0ee-bcd9383335ba" name="P21. Monitoramento da Obra">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da produ&amp;ccedil;&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios, do FNDE e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contratos Administrativos.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_4fda0f2c-5fee-4d8c-8d63-d85c6e7e0da7" name="Processo principal" processRef="Id_86a68526-c23b-4f44-9a74-b0c5bfbb7e84">
