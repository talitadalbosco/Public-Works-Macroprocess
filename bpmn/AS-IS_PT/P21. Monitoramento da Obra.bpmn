  <collaboration id="Id_060ae591-1ad3-45df-a0ee-bcd9383335ba" name="P21. Monitoramento da Obra">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da produ&amp;ccedil;&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios, do FNDE e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contrados Administrativos.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_4fda0f2c-5fee-4d8c-8d63-d85c6e7e0da7" name="Processo principal" processRef="Id_86a68526-c23b-4f44-9a74-b0c5bfbb7e84">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#000000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="isMainParticipant" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
    <participant id="Id_1f03c370-4dac-45fa-9780-51e4b610700a" name="Processo de Obras Públicas - FNDE/MEC e Municípios - P21. Monitoramento da Obra" processRef="Id_554399c0-bb48-4181-8f12-be5623267b88">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da produ&amp;ccedil;&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios, do FNDE e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contrados Administrativos.&lt;/span&gt;&lt;/p&gt;</documentation>
