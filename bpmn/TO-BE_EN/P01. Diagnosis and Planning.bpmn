    <textAnnotation id="Id_e52bd10b-d655-41db-9b89-0ec6c4d23dfd">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Early Childhood Education; Elementary School; High School</text>
    </textAnnotation>
    <textAnnotation id="Id_69653e00-8bed-4d67-8ea1-32b7b6889e96">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Where will the school that meets the pent-up demand be located</text>
    </textAnnotation>
    <textAnnotation id="Id_2fed5518-b9f0-4abe-88e7-de137d59eb8c">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Check that you meet the minimum criteria: dimensions, slope, surroundings, etc.</text>
    </textAnnotation>
    <textAnnotation id="Id_42a71d91-6a2f-4617-928c-b0ba17c857bc">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Choose the type that best meets pent demand</text>
    </textAnnotation>
    <textAnnotation id="Id_5501f717-a2ed-4fd9-b3d9-4cf60cc5366a">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>The land must have a title deed in the name of the municipality.</text>
    </textAnnotation>
    <textAnnotation id="Id_70d90851-6aa6-49d9-a688-92ae1d7c47a9">
