      </extensionElements>
      <text>Analyze the existing demand for the school's location</text>
    </textAnnotation>
    <textAnnotation id="Id_d0afe6c6-a140-44a1-aff8-b6be26c702f8">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
