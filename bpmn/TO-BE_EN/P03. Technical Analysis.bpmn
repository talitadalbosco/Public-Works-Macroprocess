            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Check compatibility of the work with the land and surroundings</text>
    </textAnnotation>
    <textAnnotation id="Id_7df611c7-9726-4ba5-ab9d-711b443f3ed6">
