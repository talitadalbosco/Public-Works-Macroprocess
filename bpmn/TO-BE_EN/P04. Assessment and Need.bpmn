  <collaboration id="Id_fd07155f-af0e-4382-a10f-74413a6f82ad" name="P04. Assessment and Need">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Process for analyzing the standard project and identifying the changes necessary to adapt the project to the implementation site, considering the synergy between the various activities of the municipalities and Law No. 14,133/2021 - Law on Public Procurement and Administrative Contracts with the activities of ISO 19650-2, Item 5.1 - Determination of needs.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_a087e12e-15dd-48ef-be55-8597a3601091" name="Processo principal" processRef="Id_f3c6767a-c612-444e-9d3d-c14612f36006">
