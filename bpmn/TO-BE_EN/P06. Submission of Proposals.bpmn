    <task id="Id_e19c70e2-4e6a-4122-a92b-cf5f11f67ab7" name="5.3.4 Establish the delivery team's capability and capacity">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Estabelecer a compet&amp;ecirc;ncia e a capacidade daequipe de entrega agregando as avalia&amp;ccedil;&amp;otilde;es conduzidas por cada equipe de tarefa produzindo assim um sum&amp;aacute;rio da compet&amp;ecirc;ncia poara garenciar e produzir infomra&amp;ccedil;&amp;atilde;o e sua capacidade para entrega da infomra&amp;ccedil;&amp;atilde;o em tempo adequado&lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_e64e79b3-e45b-45ab-9891-59f97622d894</incoming>
      <outgoing>Id_1f8103df-7e7b-47ca-8283-48db6036a6f2</outgoing>
