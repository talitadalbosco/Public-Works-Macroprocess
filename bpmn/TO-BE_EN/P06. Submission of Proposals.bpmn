      <ioSpecification id="Id_205ee4b1-2f61-4298-966e-bfc1232059fe">
        <dataOutput id="Id_9bb26928-132d-40d7-b64d-99272ada7ddd">
          <documentation />
          <dataState id="Id_2a76484a-e715-4c55-bbd3-b9531669e230" />
        </dataOutput>
        <inputSet id="Id_76e36dde-e11f-416b-aa96-4143fa84c1ba" />
