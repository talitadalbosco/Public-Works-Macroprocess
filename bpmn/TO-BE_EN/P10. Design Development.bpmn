        <targetRef>Id_2c90f005-6637-4cd3-be51-8eb392521660</targetRef>
      </dataOutputAssociation>
    </task>
    <task id="Id_09104394-93a4-4d72-90ee-dc0aeba59f64" name="5.7.2 Review and authorize the information model">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;A contratada analisa o modelo de informa&amp;ccedil;&amp;otilde;es para verificar se ele &amp;eacute; adequado para ser enviado &amp;agrave; contratante.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;O modelo de informa&amp;ccedil;&amp;otilde;es &amp;eacute; verificado para garantir que ele:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;1. aborda os requisitos de informa&amp;ccedil;&amp;otilde;es de troca (tanto os definidos pela contratante quanto os introduzidos pela contratada), incluindo crit&amp;eacute;rios de aceita&amp;ccedil;&amp;atilde;o (por exemplo, quaisquer requisitos de formata&amp;ccedil;&amp;atilde;o documentados no padr&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es do projeto)&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;bull; cont&amp;eacute;m todos os resultados apropriados do plano mestre de fornecimento de informa&amp;ccedil;&amp;otilde;es MIDP&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;bull; atender aos crit&amp;eacute;rios de aceita&amp;ccedil;&amp;atilde;o estabelecidos para cada requisito de infomra&amp;ccedil;&amp;atilde;o estabelecidos pela contratnate e&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;bull; atende ao n&amp;iacute;vel de necessidade de informa&amp;ccedil;&amp;otilde;es.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
