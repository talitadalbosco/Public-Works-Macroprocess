      <outgoing>Id_7d0c7f3e-10de-47c7-bcaf-7353c62ee111</outgoing>
    </task>
    <task id="Id_33149623-a7f8-4824-92f0-325023de2814" name="5.7.3 Submit information model for appointing party acceptance">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;A subcontratada submete suas informa&amp;ccedil;&amp;otilde;es para a contratante revisar e aceitar no ambiente comum de dados (CDE) do projeto&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
