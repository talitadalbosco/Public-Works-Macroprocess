    <task id="Id_fd3cdda7-b9a4-4cd1-b277-2c3f61062cac" name="5.6.3 a) Verification approved">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Verifica&amp;ccedil;&amp;atilde;o bem -sucedida:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;1. marcar o cont&amp;ecirc;iner de infomra&amp;ccedil;&amp;atilde;o como checado; e&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;2. armazenar o resultado da verifica&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;</documentation>
