  <collaboration id="Id_90a0a441-5999-47cb-8737-3eaef4310e47" name="P11. Supervise the Design Contract">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Process for analyzing adaptations of the standard project to local conditions, considering the synergy between the various activities of the municipalities and Law No. 14,133/2021 - Law on Public Procurement and Administrative Contracts, Item 5.7 - Delivery of the ISO 19650-2 information model.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_3eb4cd81-4843-4881-8b44-543aeb951ea0" name="Processo principal" processRef="Id_41f70460-e5e0-475f-9720-ea4b470bf526">
