            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_5fce67df-a991-461c-a036-5c5843a3a10f</incoming>
      <incoming>Id_51f8ec93-abd9-46c8-afdb-2840357216e0</incoming>
