        <documentation />
        <sourceRef>Id_5040c222-237e-46d2-b2e2-ae6c290027e0</sourceRef>
        <targetRef>Id_505b4fb8-924e-423f-b80d-33e24d0527b1</targetRef>
      </dataOutputAssociation>
    </task>
    <task id="Id_837f03b5-afd6-4dac-b938-fa40147f2c30" name="5.4.6 Complete lead appointed party's appointment documents">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Preencher os documentos do contrato, sendo importante que os documentos listados seja inclu&amp;iacute;do nos documentos de contrata&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;1. os requisitos de troca da informa&amp;ccedil;&amp;atilde;o da contratante;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;2. o padr&amp;atilde;o de informa&amp;ccedil;&amp;atilde;o do projeto;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;3. o protocolo de informa&amp;ccedil;&amp;atilde;o do projeto;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;4. o plano de execu&amp;ccedil;&amp;atilde;o BIM (BEP) da equipe de entrega;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;5. o plano de entrega da informa&amp;ccedil;&amp;atilde;o (MIDP) da equipe de entrega.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;6. os m&amp;eacute;todos e procedimentos de produ&amp;ccedil;&amp;atilde;o das infomra&amp;ccedil;&amp;otilde;es do projeto.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_73e1fa54-d9a9-48d3-a3cc-25a49b337a67</incoming>
      <outgoing>Id_92ac2afe-5c4c-4812-86c7-377a802c233a</outgoing>
    </task>
    <task id="Id_29fc31a8-b9a3-4ae6-a53e-7ceef366ea94" name="5.4.1 e) Analyze necessary additives">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Envolver-se com a contratante para concordar com quaisquer adi&amp;ccedil;&amp;otilde;es ou emendas ao padr&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es do projeto ou aos m&amp;eacute;todos e procedimentos de produ&amp;ccedil;&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_d9718f7c-15a8-4e8e-8aeb-d75428d19125</incoming>
      <outgoing>Id_c6716c3e-42c0-430d-b19a-a4d219d6305d</outgoing>
    </task>
    <task id="Id_0746dcee-2a91-484f-98c1-c68d10fa7323" name="5.4.4 Establish the task information delivery plan(s)">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Um Plano de Entrega de Informa&amp;ccedil;&amp;otilde;es da Tarefa (TIDP) &amp;eacute; um plano detalhado de como uma determinada equipe de tarefa entregar&amp;aacute; as informa&amp;ccedil;&amp;otilde;es que lhe foram solicitadas (modelos, documentos, cronogramas, c&amp;aacute;lculos, etc.). N&amp;atilde;o h&amp;aacute; um formato prescrito para o TIDP. Ele pode ser produzido em forma de tabela, planilha eletr&amp;ocirc;nica, banco de dados ou at&amp;eacute; mesmo em um gr&amp;aacute;fico de Gantt anotado.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Um TIDP tem determinados conte&amp;uacute;dos m&amp;iacute;nimos, definidos na ISO 19650-2, cl&amp;aacute;usula 5.4.4, par&amp;aacute;grafo 3.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_9fcdef1d-fd02-40b0-8155-3e4bef3ac94c</incoming>
      <outgoing>Id_1383a5ce-537b-42b1-b579-dda9f61175df</outgoing>
    </task>
    <task id="Id_1ee55a3b-8cc7-4ae5-b84a-6c748b49d59a" name="5.4.4 Establish the task information delivery plan(s)">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Um Plano de Entrega de Informa&amp;ccedil;&amp;otilde;es da Tarefa (TIDP) &amp;eacute; um plano detalhado de como uma determinada equipe de tarefa entregar&amp;aacute; as informa&amp;ccedil;&amp;otilde;es que lhe foram solicitadas (modelos, documentos, cronogramas, c&amp;aacute;lculos, etc.). N&amp;atilde;o h&amp;aacute; um formato prescrito para o TIDP. Ele pode ser produzido em forma de tabela, planilha eletr&amp;ocirc;nica, banco de dados ou at&amp;eacute; mesmo em um gr&amp;aacute;fico de Gantt anotado.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Um TIDP tem determinados conte&amp;uacute;dos m&amp;iacute;nimos, definidos na ISO 19650-2, cl&amp;aacute;usula 5.4.4, par&amp;aacute;grafo 3.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
