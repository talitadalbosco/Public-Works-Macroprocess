    </task>
    <task id="Id_d050e2a6-d315-40c0-9fcc-764396e483e5" name="5.4.5 Finalize the information delivery plan">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Infomar a contratante sobre quaisquer riscos ou quest&amp;otilde;es que possam impactar as datas-marco de entrega de infomra&amp;ccedil;&amp;atilde;o do projeto&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
