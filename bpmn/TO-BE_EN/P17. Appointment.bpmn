    </task>
    <task id="Id_33253477-d07f-45ae-8abd-81ee30a2b891" name="5.4.5 authorize">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;Autorizar os ajustes necess&amp;aacute;rios considerando os &lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;riscos ou quest&amp;otilde;es que possam impactar as datas-marco de entrega de informa&amp;ccedil;&amp;atilde;o do projeto&lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
