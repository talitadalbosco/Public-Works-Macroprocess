  <collaboration id="Id_27f91145-ebec-42fc-8e24-6d097ac55816" name="P19. Production of the Work">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Production process of the work, including information on physical progress, considering the synergy between the various activities of the municipalities and Law No. 14,133/2021 - Law on Public Procurement and Administrative Contracts, with Item 5.6 - Collaborative production of information and Item 5.7 - Delivery of the ISO 19650-2 information model.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_142a4aff-32a0-443f-8ff2-e3648fc96dbb" name="Processo principal" processRef="Id_dabf8dca-24e2-4dff-9ba3-4d40a4b37cbd">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#000000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="isMainParticipant" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
    <participant id="Id_2b704f9d-cdb4-4de3-a0bc-61651c655487" name="Public Works Process - FNDE/MEC and Municipalities - P19. Production of the Work" processRef="Id_43762da6-73c6-42d6-a1dc-6d2f7b7eeb26">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Production process of the work, including information on physical progress, considering the synergy between the various activities of the municipalities and Law No. 14,133/2021 - Law on Public Procurement and Administrative Contracts, with Item 5.6 - Collaborative production of information and Item 5.7 - Delivery of the ISO 19650-2 information model.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
