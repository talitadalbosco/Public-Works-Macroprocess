    <task id="Id_dd1ade4e-018e-40ec-91cd-383931b1e5a2" name="5.6.3 Undertake quality assurance check">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Os m&amp;eacute;todos e procedimentos de produ&amp;ccedil;&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es do projeto definem o processo de realiza&amp;ccedil;&amp;atilde;o da &amp;quot;verifica&amp;ccedil;&amp;atilde;o externa&amp;quot;. Essa atividade pode estar alinhada com o Sistema de Gerenciamento de Qualidade ISO 9001 da empresa, se isso for apropriado/acordado. Em seguida, o padr&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es do projeto determina os requisitos do cont&amp;ecirc;iner de informa&amp;ccedil;&amp;otilde;es,&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;levando em conta os requisitos do projeto: &amp;bull; ID exclusiva; &amp;bull; Status; &amp;bull; Revis&amp;atilde;o; e Classifica&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Pasos: &lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Revisar os m&amp;eacute;todos e procedimentos de produ&amp;ccedil;&amp;atilde;o do projeto&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Revisar o padr&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es do projeto&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Realizar a verifica&amp;ccedil;&amp;atilde;o&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:36pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Se a verifica&amp;ccedil;&amp;atilde;o for bem-sucedida, marque o cont&amp;ecirc;iner de informa&amp;ccedil;&amp;otilde;es como verificado&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:36pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Se a verifica&amp;ccedil;&amp;atilde;o n&amp;atilde;o for bem-sucedida, rejeite o cont&amp;ecirc;iner de informa&amp;ccedil;&amp;otilde;es e avise o autor das informa&amp;ccedil;&amp;otilde;es&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
