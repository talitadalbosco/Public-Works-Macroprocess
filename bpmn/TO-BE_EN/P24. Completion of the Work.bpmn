  <collaboration id="Id_5ba883b3-1336-4aca-9ad7-7f003813891c" name="P24. Completion of the Work">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Process for analyzing the completion of the work, including information on physical progress, considering the synergy between the various activities of the municipalities, the FNDE, and Law No. 14,133/2021 - Law on Public Procurement and Administrative Contracts, with the activities of ISO 19650-2.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_41d2bbd9-c8c2-4a36-a62d-02ed87fce5e1" name="Processo principal" processRef="Id_377e4a91-05fa-4a6b-9d15-14cb74a630d1">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
