  <collaboration id="Id_feb1be0b-4e56-429c-81aa-43a244cee65a" name="P00_Macroprocesso de Obras Públicas FNDE e Municípios - TO BE">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Este mapa representa o ciclo completo de contrata&amp;ccedil;&amp;atilde;o de obra p&amp;uacute;blica com recursos financeiros do FNDE.&lt;/span&gt;&lt;/p&gt;</documentation>
