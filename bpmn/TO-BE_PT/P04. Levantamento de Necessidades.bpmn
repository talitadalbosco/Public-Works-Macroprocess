    <task id="Id_76151c75-15ce-4958-adb0-88da2c9b88e0" name="SP2. Designar a Equipe de Planejamento">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;Eacute; o ato formal que designa o conjunto de agentes que re&amp;uacute;nem as compet&amp;ecirc;ncias necess&amp;aacute;rias &amp;agrave; completa execu&amp;ccedil;&amp;atilde;o das etapas de planejamento da contrata&amp;ccedil;&amp;atilde;o, o que inclui conhecimentos sobre aspectos t&amp;eacute;cnicos-operacionais e de uso do objeto, licita&amp;ccedil;&amp;otilde;es e contratos, dentre outros.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Atente-se o &amp;oacute;rg&amp;atilde;o e a entidade assessorados para as especificidades que envolvem obras e servi&amp;ccedil;os de engenharia, devendo a designa&amp;ccedil;&amp;atilde;o dos agentes atender as cautelas trazidas no Cap&amp;iacute;tulo &amp;ldquo;&lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:bold;font-style:normal;"&gt;Comprovacao da Responsabilidade Tecnica&lt;/span&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;rdquo; logo a seguir.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#C4BD97" />
            <bizagi:BizagiProperty name="borderColor" value="#746D47" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
