  <collaboration id="Id_d203e000-a2b6-4fac-a583-c9835ec2c7d8" name="P04. Levantamento de Necessidades">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo para an&amp;aacute;lise do projeto padr&amp;atilde;o e identifica&amp;ccedil;&amp;atilde;o das altera&amp;ccedil;&amp;otilde;es necess&amp;aacute;rias para adaptar o projeto ao local de implanta&amp;ccedil;&amp;atilde;o, considerando a Sinergia entre as atividades diversas dos munic&amp;iacute;pios e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contrados Administrativos com as atividades da ISO 19650-2, Item 5.1 - Determina&amp;ccedil;&amp;atilde;o das necessidades.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_7eaa5053-6c7b-46d3-bf51-e383d77de47d" name="Processo principal" processRef="Id_65ae3d12-e131-48b9-ab11-68f1534fe1c7">
