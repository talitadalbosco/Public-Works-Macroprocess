    <task id="Id_69ff4da0-f064-4a2e-9b68-6a9a223d64e5" name="Avaliar projeto padrão do FNDE">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Avaliar todo o conjunto de documentos que comp&amp;otilde;em o projeto padr&amp;atilde;o do FNDE&lt;/span&gt;&lt;/p&gt;</documentation>
