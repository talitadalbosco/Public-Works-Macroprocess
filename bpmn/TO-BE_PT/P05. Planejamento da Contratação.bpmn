      <outgoing>Id_772cfc0b-aeef-46cb-af1a-53f0890000e9</outgoing>
      <resourceRole id="Id_07a7cda3-0600-495b-a59f-92052d61d17c">
        <q10:resourceRef xmlns="" xmlns:q10="http://www.omg.org/spec/BPMN/20100524/MODEL">EnteFederativo</q10:resourceRef>
