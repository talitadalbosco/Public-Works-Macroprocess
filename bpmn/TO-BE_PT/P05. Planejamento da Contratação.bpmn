      <outgoing>Id_6fb41e74-8a96-41be-b868-9f1a7f0ad7aa</outgoing>
      <ioSpecification id="Id_9ab93fe0-d3ff-4e80-b69f-2454c0cc9423">
        <dataOutput id="Id_b6ed98b3-e2df-4da0-ac81-d706b584eb3d">
