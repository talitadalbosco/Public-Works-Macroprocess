          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_86f4fe7f-b376-4ac8-86c3-de31859ab3a1</incoming>
      <outgoing>Id_e52eea35-fbb1-49f7-95e6-3bfae673c7fd</outgoing>
      <ioSpecification id="Id_d50e09da-e2fd-41c9-9111-cd9e7d075b57">
        <dataOutput id="Id_a2c74840-30f8-44fa-bd3b-84e7b7e2886b">
          <documentation />
          <dataState id="Id_36a6f5e9-5ecb-4271-971d-b71b0ce9d250" />
        </dataOutput>
        <inputSet id="Id_f31efcd7-0885-4e62-b939-9872b208e0e4" />
        <outputSet id="Id_a6af16ac-8f13-4e73-a288-fe956678e627">
          <dataOutputRefs>Id_a2c74840-30f8-44fa-bd3b-84e7b7e2886b</dataOutputRefs>
