    <task id="Id_6bfab298-60fa-4b1e-8575-be5f7922202e" name="5.4.4 Estabelecer o plano de entrega de tarefas">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Um Plano de Entrega de Informa&amp;ccedil;&amp;otilde;es da Tarefa (TIDP) &amp;eacute; um plano detalhado de como uma determinada equipe de tarefa entregar&amp;aacute; as informa&amp;ccedil;&amp;otilde;es que lhe foram solicitadas (modelos, documentos, cronogramas, c&amp;aacute;lculos, etc.). N&amp;atilde;o h&amp;aacute; um formato prescrito para o TIDP. Ele pode ser produzido em forma de tabela, planilha eletr&amp;ocirc;nica, banco de dados ou at&amp;eacute; mesmo em um gr&amp;aacute;fico de Gantt anotado.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Um TIDP tem determinados conte&amp;uacute;dos m&amp;iacute;nimos, definidos na ISO 19650-2, cl&amp;aacute;usula 5.4.4, par&amp;aacute;grafo 3.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Calibri;font-size:11pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
