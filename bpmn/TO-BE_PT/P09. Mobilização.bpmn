  <process id="Id_f9965b39-f847-4018-83e1-26b0e4463693" name="Processo de Obras Públicas - FNDE/MEC e Municípios - P09. Mobilização">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de mobiliza&amp;ccedil;&amp;atilde;o para in&amp;iacute;cio das atividades considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contrados Administrativos com o Item 5.5 - Mobiliza&amp;ccedil;&amp;atilde;o da ISO 19650-2.&lt;/span&gt;&lt;/p&gt;</documentation>
