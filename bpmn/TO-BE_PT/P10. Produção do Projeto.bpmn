    <task id="Id_39f226d2-b12d-4f74-b6b6-a2554e73f151" name="5.7.1 Submeter o modelo de informação">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Esta cl&amp;aacute;usula &amp;eacute; a primeira etapa do processo de entrega do modelo de informa&amp;ccedil;&amp;otilde;es como uma troca de informa&amp;ccedil;&amp;otilde;es para a contratante e sua aceita&amp;ccedil;&amp;atilde;o como informa&amp;ccedil;&amp;otilde;es publicadas.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Cada equipe de tarefa busca a autoriza&amp;ccedil;&amp;atilde;o da contratada para seus cont&amp;ecirc;ineres de informa&amp;ccedil;&amp;otilde;es relevantes.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;O processo de envio deve estar de acordo com os m&amp;eacute;todos e procedimentos de produ&amp;ccedil;&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es do projeto.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_623dc527-8175-4ba4-bf8e-01a375f6ada9</incoming>
