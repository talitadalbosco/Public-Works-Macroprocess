        <q5:resourceRef xmlns="" xmlns:q5="http://www.omg.org/spec/BPMN/20100524/MODEL">Subcontratadas</q5:resourceRef>
      </resourceRole>
      <resourceRole id="Id_249d669e-992d-449e-b1fd-be64edf017e3">
