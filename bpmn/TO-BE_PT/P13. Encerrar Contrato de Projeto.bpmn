    <task id="Id_914a17f6-ad48-4322-ade8-77887f4587af" name="8.2 Receber provisoriamente">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:10pt;font-weight:normal;font-style:normal;"&gt;Art. 140. O objeto do contrato ser&amp;aacute; recebido:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:10pt;font-weight:normal;font-style:normal;"&gt;I - em se tratando de obras e servi&amp;ccedil;os:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:10pt;font-weight:normal;font-style:normal;"&gt;a) provisoriamente, pelo respons&amp;aacute;vel por seu acompanhamento e fiscaliza&amp;ccedil;&amp;atilde;o, mediante termo detalhado,quando verificado o cumprimento das exig&amp;ecirc;ncias de car&amp;aacute;ter t&amp;eacute;cnico;&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#C4BD97" />
            <bizagi:BizagiProperty name="borderColor" value="#746D47" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_b3bada63-c64a-44ea-83a1-a84121452b7f</incoming>
