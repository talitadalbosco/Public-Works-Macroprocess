      <outgoing>Id_13969cb9-5eb0-414a-af65-6bc9cc741a35</outgoing>
      <resourceRole id="Id_76a45684-8943-423c-b12f-281a395417e8">
        <q12:resourceRef xmlns="" xmlns:q12="http://www.omg.org/spec/BPMN/20100524/MODEL">EnteFederativo</q12:resourceRef>
