      </extensionElements>
      <text>Prazo a depender do regime de execução definido em edital</text>
    </textAnnotation>
    <textAnnotation id="Id_f2ea76c4-26a6-4b2f-ae44-fa74213dbd0a">
      <documentation />
      <extensionElements>
