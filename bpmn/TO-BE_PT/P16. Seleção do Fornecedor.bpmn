      <ioSpecification id="Id_6f28188d-a437-4a2d-ab8b-c47af448cb95">
        <dataInput id="Id_e8df5a65-5f4d-4158-8ea3-350b6c521bcd">
          <documentation />
          <dataState id="Id_29bdc9ea-0cac-4420-a064-37fa4f4e7a80" />
        </dataInput>
        <dataInput id="Id_0cdec532-b2ab-4696-9d26-bb4f6d4afa43">
          <documentation />
          <dataState id="Id_7170a0ef-8f85-4706-bf27-1c0eb900ebc9" />
        </dataInput>
        <inputSet id="Id_477ec538-72e1-4968-81b8-0bc4498e3e71">
          <dataInputRefs>Id_e8df5a65-5f4d-4158-8ea3-350b6c521bcd</dataInputRefs>
