    <task id="Id_cae74da3-089c-4fb1-84fd-409cc1c10ec4" name="Analisar e aprovar documentação">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Analisar BEP e demais documentos e promover a aprova&amp;ccedil;&amp;atilde;o para dar sequencia na formaliza&amp;ccedil;&amp;atilde;o do contrato&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
