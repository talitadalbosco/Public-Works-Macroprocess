    <task id="Id_96ab76b7-1bff-4bed-8a05-04432e80c16d" name="7.1 Convocar a empresa vencedora">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Lei n&amp;ordm; 14.133&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Art. 90. A Administra&amp;ccedil;&amp;atilde;o convocar&amp;aacute; regularmente o licitante vencedor para assinar o termo de contrato ou paraaceitar ou retirar o instrumento equivalente, dentro do prazo e nas condi&amp;ccedil;&amp;otilde;es estabelecidas no edital de licita&amp;ccedil;&amp;atilde;o, sobpena de decair o direito &amp;agrave; contrata&amp;ccedil;&amp;atilde;o, sem preju&amp;iacute;zo das san&amp;ccedil;&amp;otilde;es previstas nesta Lei.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#C4BD97" />
            <bizagi:BizagiProperty name="borderColor" value="#746D47" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_5a6d656f-03db-44d0-8495-74ccc3c6d40d</incoming>
      <outgoing>Id_3db46c2a-dddb-42df-b01d-52df338df8f8</outgoing>
      <ioSpecification id="Id_90a2a8de-0c28-4560-8a3a-fe3978f9ab65">
