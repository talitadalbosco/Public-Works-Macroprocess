    <task id="Id_2c63e96c-f265-4a5e-9310-034153ec89ba" name="7.4 Publicação do Contrato">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Lei &amp;ordm; 14.133&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Art. 94. A divulga&amp;ccedil;&amp;atilde;o no Portal Nacional de Contrata&amp;ccedil;&amp;otilde;es P&amp;uacute;blicas (PNCP) &amp;eacute; condi&amp;ccedil;&amp;atilde;o indispens&amp;aacute;vel para aefic&amp;aacute;cia do contrato e de seus aditamentos e dever&amp;aacute; ocorrer nos seguintes prazos, contados da data de suaassinatura:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;I - 20 (vinte) dias &amp;uacute;teis, no caso de licita&amp;ccedil;&amp;atilde;o; &lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#C4BD97" />
