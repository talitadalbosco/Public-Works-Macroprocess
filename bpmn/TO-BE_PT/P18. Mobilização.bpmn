            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_ed449133-d883-4796-a7fb-81c5fe94ce14</incoming>
      <outgoing>Id_9ca75253-e446-4ce3-a95e-0829af95240f</outgoing>
      <resourceRole id="Id_afc0e05a-a06c-4695-b58f-341797424cd1">
        <q7:resourceRef xmlns="" xmlns:q7="http://www.omg.org/spec/BPMN/20100524/MODEL">Empresas</q7:resourceRef>
