    <task id="Id_06125dfb-3cd2-4f0f-9e4d-767c626be56d" name="5.6.1 Checar a disponibilidade da informação">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;As informa&amp;ccedil;&amp;otilde;es de refer&amp;ecirc;ncia e os recursos compartilhados s&amp;atilde;o fornecidos inicialmente pela contratante (cl&amp;aacute;usula 5.2.2) e podem ser revisados e ampliados pela contratada (cl&amp;aacute;usula 5.4.3 e).&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;As informa&amp;ccedil;&amp;otilde;es de refer&amp;ecirc;ncia e os recursos compartilhados s&amp;atilde;o mantidos no ambiente de dados comum (CDE) do projeto.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Analise quais informa&amp;ccedil;&amp;otilde;es de refer&amp;ecirc;ncia e recursos compartilhados est&amp;atilde;o acess&amp;iacute;veis no CDE do projeto, com tempo suficiente antes do in&amp;iacute;cio do trabalho t&amp;eacute;cnico e da gera&amp;ccedil;&amp;atilde;o de informa&amp;ccedil;&amp;otilde;es, e compare-os com os requisitos da equipe de trabalho.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:Arial;font-size:9pt;font-weight:normal;font-style:normal;"&gt;Informar qualquer d&amp;eacute;ficit &amp;agrave; contratada.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#E5B9B7" />
            <bizagi:BizagiProperty name="borderColor" value="#956967" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
