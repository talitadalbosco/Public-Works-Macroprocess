  </resource>
  <collaboration id="Id_4d2163ce-4858-41a8-a786-6da9ccbc1fc2" name="P20. Fiscalizar Contrato de Obra">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da produ&amp;ccedil;&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contrados Administrativos com o Item 5.7 - Entrega do modelo de informa&amp;ccedil;&amp;atilde;o da ISO 19650-2.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_b8c5ff96-699b-4d9b-a5c1-502740690b92" name="Processo principal" processRef="Id_6177322c-53ec-4ca5-8110-1a9b7c23f6cd">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#000000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="isMainParticipant" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
    <participant id="Id_3c775deb-f62a-4667-893a-1d7303105b00" name="Processo de Obras Públicas - FNDE/MEC e Municípios - P20. Fiscalizar Contrato de Obra" processRef="Id_bb24a386-7593-4b49-b55c-b10e58c25828">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da produ&amp;ccedil;&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contrados Administrativos com o Item 5.7 - Entrega do modelo de informa&amp;ccedil;&amp;atilde;o da ISO 19650-2.&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</documentation>
