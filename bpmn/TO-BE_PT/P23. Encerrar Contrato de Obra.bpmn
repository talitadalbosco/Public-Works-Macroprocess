    <task id="Id_fd32bc95-848e-4fb9-a2c7-79d34a81f085" name="8.5 Receber definitivo">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Art. 140. O objeto do contrato ser&amp;aacute; recebido:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;I - em se tratando de obras e servi&amp;ccedil;os:&lt;/span&gt;&lt;/p&gt;&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;b) definitivamente, por servidor ou comiss&amp;atilde;o designada pela autoridade competente, mediante termo detalhadoque comprove o atendimento das exig&amp;ecirc;ncias contratuais.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#C4BD97" />
            <bizagi:BizagiProperty name="borderColor" value="#746D47" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <incoming>Id_2b15ed2d-d32f-4571-8665-77dd5cc29f94</incoming>
      <outgoing>Id_ad7f62e7-446e-42e9-bd5a-da8c4bbeba50</outgoing>
    </task>
    <task id="Id_99bdf858-c362-4dff-be81-8c17d50b4295" name="8.4 Aprovar">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#C4BD97" />
            <bizagi:BizagiProperty name="borderColor" value="#746D47" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
