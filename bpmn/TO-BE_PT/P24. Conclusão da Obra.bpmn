    <documentation />
  </resource>
  <resource id="EmpresaSupervisora" name="Empresa Supervisora">
    <documentation />
  </resource>
  <collaboration id="Id_7859686b-ec3f-4bf0-8131-460c23746d00" name="P24. Conclusão da Obra">
    <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da conclus&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios, do FNDE e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contratos Administrativos com as atividades da ISO 19650-2.&lt;/span&gt;&lt;/p&gt;</documentation>
    <participant id="Id_c550f43b-a4d5-4cae-9d2b-12a337de1e1b" name="Processo principal" processRef="Id_fa936e06-bea5-43e6-8072-9ace2f268787">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#FFFFFF" />
            <bizagi:BizagiProperty name="borderColor" value="#000000" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
            <bizagi:BizagiProperty name="isMainParticipant" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
    </participant>
    <participant id="Id_4c228d7a-2ba3-4c7c-8809-6c8da7c52822" name="Processo de Obras Públicas - FNDE/MEC e Municípios - P24. Conclusão da Obra" processRef="Id_2be2f140-3a53-4fa4-8ece-5dd8919254e0">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de an&amp;aacute;lise da conclus&amp;atilde;o da obra contemplando a informa&amp;ccedil;&amp;atilde;o do avan&amp;ccedil;o f&amp;iacute;sico considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios, do FNDE e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contratos Administrativos com as atividades da ISO 19650-2.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
