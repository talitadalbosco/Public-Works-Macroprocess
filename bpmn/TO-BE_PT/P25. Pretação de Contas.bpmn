      </extensionElements>
    </participant>
    <participant id="Id_ec001ce2-dcf3-4068-aacd-04a087a680db" name="Processo de Obras Públicas - FNDE/MEC e Municípios - P25. Prestação de Contass" processRef="Id_9a3a34d4-fba5-438b-b748-9a21c3270de3">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Times New Roman';font-size:12pt;font-weight:normal;font-style:normal;"&gt;Processo de organiza&amp;ccedil;&amp;atilde;o e envio da presta&amp;ccedil;&amp;atilde;o de contas considerando a sinergia entre as atividades diversas dos munic&amp;iacute;pios, do FNDE e da Lei n&amp;ordm; 14.133/2021 - Lei de Licita&amp;ccedil;&amp;otilde;es e Contrados Administrativos com as atividades da ISO 19650-2.&lt;/span&gt;&lt;/p&gt;</documentation>
