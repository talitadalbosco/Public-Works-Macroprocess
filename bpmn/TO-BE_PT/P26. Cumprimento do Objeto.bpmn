  <resource id="FNDE" name="FNDE">
    <documentation>Entidade que aprova o projeto para liberação de recursos financeiros para a execução da obra</documentation>
  </resource>
  <resource id="EnteFederativo" name="Municípios">
    <documentation>Municípios, Estados e o Distrito Federal</documentation>
  </resource>
  <resource id="Subcontratadas" name="Parte Fornecedora">
    <documentation>Empresa subcontratada ou que fornece a infomração</documentation>
  </resource>
  <resource id="Empresas" name="Parte Fornecedora Líder">
    <documentation>Entidades participantes do processo de licitação ou Empresas contratadas</documentation>
  </resource>
