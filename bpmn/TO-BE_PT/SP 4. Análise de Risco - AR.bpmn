      <outgoing>Id_3ce16303-3711-40ed-9a01-dd2bfc1052bc</outgoing>
      <ioSpecification id="Id_d030a393-e047-4a43-9341-667d12258cd8">
        <dataInput id="Id_aa6b62fe-19f1-4653-8a9e-790a1e88b96c">
          <documentation />
          <dataState id="Id_65275d89-a13e-4d21-ada0-fbfecc68d512" />
        </dataInput>
        <dataInput id="Id_7450ec08-7f67-4500-9f8a-d0aebe980115">
          <documentation />
          <dataState id="Id_98a891e5-5057-4a74-960a-111e389a4775" />
        </dataInput>
