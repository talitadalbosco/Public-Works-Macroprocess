      <outgoing>Id_3ce16303-3711-40ed-9a01-dd2bfc1052bc</outgoing>
      <ioSpecification id="Id_f88c7d07-75b5-42cf-8958-d30e45f9af7a">
        <dataInput id="Id_aa6b62fe-19f1-4653-8a9e-790a1e88b96c">
          <documentation />
          <dataState id="Id_fd9e2d90-8d3a-4733-b477-3b0946088d33" />
        </dataInput>
        <dataInput id="Id_7450ec08-7f67-4500-9f8a-d0aebe980115">
          <documentation />
          <dataState id="Id_3e7ecdc3-4cb8-43a7-bcfc-cc8f405c86bc" />
        </dataInput>
